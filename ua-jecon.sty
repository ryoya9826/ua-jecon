% ua-jecon.sty
% 
% A wrapper package for ua-jecon.bst (Japanese Economic Review style modified)
% 
% Author:  Ryoya Ando
% URL:     https://ryoya9826.github.io/
% License: LaTeX Project Public License (LPPL) version 1.3c or later
% 
% Description:
% This package provides a simple way to use ua-jecon.bst.
% ua-jecon.bst is a derived work of jecon.bst (v6.2.1) created by Shiro Takeda.
% It automatically loads the required `natbib` package, sets the bibliography 
% style to `ua-jecon`, and defines the `\acite` command to output amsrefs-like 
% compressed labels generated by ua-jecon.bst.
% 
% Usage:
% \usepackage{ua-jecon}
% \acite{key}         -> [Label]
% \acite{key}*{note}  -> [Label, note]
% ----------------------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ua-jecon}[2026/04/21 v0.7 Wrapper package for ua-jecon.bst]

% 必須パッケージの読み込み
\RequirePackage{natbib}

\newcommand{\acite}[1]{%
  \nocite{#1}
  \gdef\m@syu@cite@temp{#1}\@ifstar\m@syu@cite@\m@syu@cite
}
\def\m@syu@cite@#1{[\csname m@syu@ams@\m@syu@cite@temp\endcsname, #1]}
\def\m@syu@cite{[\csname m@syu@ams@\m@syu@cite@temp\endcsname]}

% デフォルトのスタイルとして ua-jecon を指定
\bibliographystyle{ua-jecon}

\endinput